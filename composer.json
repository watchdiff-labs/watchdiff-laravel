{
    "name": "watchdiff-labs/watchdiff-laravel",
    "description": "Laravel service provider for watchdiff-core - web change monitoring with Artisan commands and scheduler integration.",
    "type": "library",
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/watchdiff-labs/watchdiff-laravel",
    "support": {
        "issues": "https://github.com/watchdiff-labs/watchdiff-laravel/issues",
        "source": "https://github.com/watchdiff-labs/watchdiff-laravel"
    },
    "keywords": [
        "watchdiff",
        "laravel",
        "monitoring",
        "diff",
        "change-detection"
    ],
    "require": {
        "php": "^8.1",
        "watchdiff-labs/watchdiff-core": "^0.1.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/events": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.57",
        "php-http/mock-client": "^1.6",
        "nyholm/psr7": "^1.8",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "WatchDiff\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WatchDiff\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WatchDiff\\Laravel\\WatchDiffServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
